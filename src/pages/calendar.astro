---
import CalendarSection from "@components/Calendar/Calendar.astro";
import Contact from "@components/Contact/Contact.astro";
import { CALENDAR, CLOSED_LABEL, HOURS_LABEL, currentMonth } from "@/data/calendar";
import { specialHoursSchema } from "@/lib/structured-data";
import BaseLayout from "@layouts/BaseLayout.astro";
// OGP画像。既定の夜の外観ではなく、庭の見える店内を出す
import ogImage from "@assets/images/enlee-interior-day.jpg";

const m = currentMonth();
// 🔴 表示している「いつもと違う日」だけを構造化データに入れる（→ src/lib/structured-data.ts）
const schemas = [specialHoursSchema(m)].filter(Boolean);

const different = m.days.length;
const description =
	`Enlee（エンリー）${m.year}年${m.month}月の営業カレンダー。通常は ${HOURS_LABEL}／${CLOSED_LABEL}。` +
	(different > 0
		? `今月は ${m.days.map((d) => `${m.month}/${d.day} ${d.title}`).join("、")}。`
		: "今月はいつもどおりの営業です。") +
	"貸切・ご宴会・BBQ のご相談は公式LINEへどうぞ。";
---

<BaseLayout
	title={`${m.month}月の営業カレンダー`}
	description={description}
	heroImage={ogImage}
	schemas={schemas}
>
	<div class="pt-24 md:pt-36">
		<CalendarSection />
	</div>

	{
		CALENDAR.length > 1 && (
			<p class="site-container description mt-10 text-sm">
				翌月以降のご予定は、決まりしだいこちらと公式LINEでお知らせいたします。
			</p>
		)
	}

	<Contact class="mt-12" />
</BaseLayout>
