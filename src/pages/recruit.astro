---
/**
 * 採用ページ（/recruit）
 *
 * 方針（2026-09-27 本人判断）:
 *   - 募集条件・時給などの求人要項は書かない。「どんな人が、どんな思いで働いているか」に絞る
 *     （要項は Indeed 側に置く。条件が固まったらこのページに足す）
 *   - スタッフ紹介は src/data/staff/ のデータが入ると自動で出る（draft: false にしたとき）
 *   - 文言は src/data/recruit.ts に集約。書き換えるときはそちらだけ触る
 */

import Button from "@components/Button/Button.astro";
import Contact from "@components/Contact/Contact.astro";
import Staff from "@components/Staff/Staff.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { RECRUIT_CONTACT, RECRUIT_DAY, RECRUIT_HERO, RECRUIT_PATH, RECRUIT_PROMISES } from "@/data/recruit";
import heroImage from "@assets/images/enlee-interior-bright.jpg";
import nightImage from "@assets/images/enlee-venue-night.jpg";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
---

<BaseLayout
	title="採用情報"
	description="福山・中央公園の中のガーデンレストランEnlee（エンリー）で働く人たちのご紹介と、採用のご相談窓口です。「様々な人が集まり、合わさり。素敵な日常をつくりだす。」"
>
	<!-- 導入 -->
	<section class="site-container pt-24 md:pt-36">
		<div class="flex flex-col md:flex-row md:items-center">
			<div class="md:w-1/2 md:pr-16">
				<p class="h3 text-primary-500 text-pretty uppercase">{RECRUIT_HERO.eyebrow}</p>
				<h1 class="h2 mt-4"><span class="sr-only">採用情報｜</span>{RECRUIT_HERO.heading}</h1>
				<p class="mt-8 text-pretty lg:text-lg">{RECRUIT_HERO.lead}</p>
			</div>
			<div class="mt-10 md:mt-0 md:w-1/2">
				<div class="aspect-[4/3] w-full overflow-hidden">
					<Image
						src={heroImage}
						alt="光の入るEnleeの店内"
						width={720}
						densities={[1.5, 2]}
						class="h-full w-full object-cover"
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- Enleeの一日 -->
	<section class="site-container py-20 md:py-32">
		<div class="mx-auto max-w-3xl text-center">
			<h2 class="h2 text-pretty">Enleeの一日</h2>
			<p class="mt-6 text-pretty lg:text-lg">
				営業は 11:00〜21:00（L.O.20:00）、定休日は火曜日です。同じ店でも、時間帯によって景色も仕事も変わります。
			</p>
		</div>
		<div class="mx-auto grid max-w-md gap-12 pt-12 lg:max-w-none lg:grid-cols-3">
			{
				RECRUIT_DAY.map((item) => (
					<div class="border-primary-300 border-t pt-6">
						<p class="font-heading-1 text-primary-500 text-3xl italic">{item.time}</p>
						<h3 class="h3 mt-3 tracking-widest">{item.title}</h3>
						<p class="mt-4 text-pretty">{item.body}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- スタッフ紹介（src/data/staff/ にデータが入ると表示される） -->
	<Staff
		heading="Enleeをつくっている人"
		description="ホール、キッチン、パティシエ。いろいろな入り方をした人が、同じ店で働いています。"
	/>

	<!-- 大切にしていること -->
	<section class="bg-base-100/40 py-20 md:py-32">
		<div class="site-container">
			<div class="flex flex-col md:flex-row">
				<div class="md:w-1/2 md:pr-16">
					<h2 class="h2 text-pretty">大切にしている、三つのこと</h2>
					<div class="mt-10 space-y-10">
						{
							RECRUIT_PROMISES.map((item) => (
								<div class="flex gap-6">
									<p class="font-heading-1 text-primary-400 shrink-0 text-3xl italic">
										{item.label}
									</p>
									<div>
										<h3 class="h3 tracking-widest">{item.title}</h3>
										<p class="mt-3 text-pretty">{item.body}</p>
									</div>
								</div>
							))
						}
					</div>
				</div>
				<div class="mt-12 md:mt-0 md:w-1/2">
					<div class="aspect-[3/4] w-full overflow-hidden">
						<Image
							src={nightImage}
							alt="灯りがともった夜のEnlee"
							width={600}
							densities={[1.5, 2]}
							class="h-full w-full object-cover"
						/>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- アルバイトから社員への道（時給の金額は出さない） -->
	<section class="py-20 md:py-32">
		<div class="site-container">
			<div class="mx-auto max-w-3xl text-center">
				<h2 class="h2 text-pretty">{RECRUIT_PATH.heading}</h2>
				<p class="mt-6 text-pretty lg:text-lg">{RECRUIT_PATH.lead}</p>
			</div>
			<ol class="mx-auto mt-12 max-w-2xl space-y-4">
				{
					RECRUIT_PATH.steps.map((s, i) => (
						<li class="border-primary-300 flex items-baseline gap-6 border-t pt-4">
							{/* 🔴 font-heading-1（Cormorant）の斜体だと「1」が「I」に見える。数字が判る書体にする */}
							<p class="font-heading-2 text-primary-400 w-8 shrink-0 text-2xl tabular-nums">{i + 1}</p>
							<div>
								<h3 class="h3 tracking-widest">{s.name}</h3>
								<p class="mt-2 text-pretty">{s.what}</p>
							</div>
						</li>
					))
				}
				<li class="border-primary-500 bg-base-50 flex items-baseline gap-6 border px-4 py-5">
					<Icon name="tabler:chevron-down" class="text-primary-500 size-8 shrink-0" aria-hidden="true" />
					<div>
						<h3 class="h3 text-primary-600 tracking-widest">{RECRUIT_PATH.goal.name}</h3>
						<p class="mt-2 text-pretty">{RECRUIT_PATH.goal.what}</p>
					</div>
				</li>
			</ol>
			<p class="mx-auto mt-10 max-w-2xl text-pretty lg:text-lg">{RECRUIT_PATH.note}</p>
		</div>
	</section>

	<!-- 応募・ご相談 -->
	<section id="recruit-contact" class="site-container scroll-mt-10 py-20 md:py-32">
		<div class="mx-auto max-w-3xl text-center">
			<h2 class="h2 text-pretty">{RECRUIT_CONTACT.heading}</h2>
			<p class="mt-6 text-pretty lg:text-lg">{RECRUIT_CONTACT.body}</p>

			<div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
				<Button
					href={RECRUIT_CONTACT.lineUrl}
					target="_blank"
					rel="noopener noreferrer"
					arrow="right"
					class="px-8"
				>
					公式LINEで相談する
				</Button>
				{
					RECRUIT_CONTACT.indeedUrl && (
						<Button
							href={RECRUIT_CONTACT.indeedUrl}
							target="_blank"
							rel="noopener noreferrer"
							variant="outline"
							arrow="right"
							class="px-8"
						>
							募集中の求人を見る
						</Button>
					)
				}
			</div>

			<p class="mt-8 flex items-center justify-center gap-2 text-lg">
				<Icon name="tabler:phone" class="size-5 shrink-0" aria-hidden="true" />
				<a href={`tel:${RECRUIT_CONTACT.tel}`} class="underline underline-offset-4">
					{RECRUIT_CONTACT.tel}
				</a>
			</p>
		</div>
	</section>

	<Contact class="mt-12" />
</BaseLayout>
