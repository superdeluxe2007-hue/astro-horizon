---
// components
import Contact from "@components/Contact/Contact.astro";
import PortfolioGrid from "@components/Portfolio/PortfolioGrid.astro";
import TestimonialQuote from "@components/Testimonials/TestimonialQuote.astro";
// layout
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

const portfolios = await getCollection("portfolios", ({ data }) => {
	// filter out draft pages
	return data.draft !== true;
});
---

<BaseLayout
	title="ご利用シーン・プラン"
	description="Enlee（福山市・中央公園内）の貸切・ご宴会プラン。忘年会・新年会・歓送迎会・懇親会・同窓会などに。最大70名様まで（半立食のブッフェの場合・着席は65名様まで）。コース・ブッフェ・屋外BBQからお選びいただけます。"
>
	<div class="site-container pt-24 md:pt-36">
		<div class="mx-auto max-w-6xl text-center">
			<h1 class="h2 text-pretty uppercase">ご利用シーン・貸切プラン</h1>
			{/* 30〜70名のご宴会が増えているので、入口で受けられる人数を先に出す */}
			<p class="description mx-auto mt-6 max-w-2xl text-pretty">
				ご宴会・貸切は <span class="text-primary-700">最大70名様</span
				>まで承ります（半立食のブッフェの場合。着席は65名様まで）。<br />
				コース・ブッフェ・屋外BBQから、ご人数とご予算に合わせてお選びいただけます。
			</p>
			{/* 2026-11-12 の打ち合わせ: 企業のご宴会の需要に、探される言葉で応える */}
			<p class="description mx-auto mt-4 max-w-2xl text-pretty">
				忘年会・新年会・歓送迎会・懇親会・同窓会など、会社やグループでのお集まりにご利用いただけます。
			</p>
		</div>
		<PortfolioGrid portfolios={portfolios} />
		{/* 会社の幹事さん向けの記事への入口（2026-11-13） */}
		<p class="description mx-auto mt-10 max-w-2xl text-center text-pretty">
			セミナー・研修の会場やお弁当をお探しの方は、<a href="/guide/" class="text-primary-600 underline underline-offset-4">ご利用ガイド</a>もご覧ください。
		</p>
	</div>

	<TestimonialQuote />

	<Contact class="mt-12" />
</BaseLayout>
