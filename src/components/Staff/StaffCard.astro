---
/**
 * * スタッフ紹介カード（採用ページ）
 *
 * 写真は本人の同意が取れたものだけを置く（→ LLM Wiki brand/enlee §4）。
 * 未設定のあいだは、名前の頭文字を置いた枠を表示してレイアウトを保つ。
 */

import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
	staff: CollectionEntry<"staff">;
}

const { staff } = Astro.props as Props;
const { name, role, since, image, imageAlt, lead, questions } = staff.data;

// 写真が無いときに置く頭文字（「村上 渚」→「村」）
const initial = name.trim().charAt(0);
---

<article class="grid gap-1">
	<div class="bg-base-100/60 border-primary-200 aspect-[3/4] overflow-hidden border">
		{
			image ? (
				<Image
					src={image}
					alt={imageAlt ?? `${role}の${name}`}
					width={450}
					densities={[1.5, 2]}
					class="h-auto min-h-full w-full min-w-full object-cover"
				/>
			) : (
				<div class="text-primary-300 flex h-full w-full items-center justify-center">
					<span class="font-heading-1 text-7xl" aria-hidden="true">
						{initial}
					</span>
					<span class="sr-only">写真は準備中です</span>
				</div>
			)
		}
	</div>

	<div class="mt-6">
		<p class="text-primary-500 text-sm tracking-widest uppercase">{role}</p>
		<h3 class="h3 mt-2 tracking-widest">{name}</h3>
		{since && <p class="mt-1 text-sm opacity-70">{since}</p>}

		<hr class="border-primary-400 mt-5 mb-6 w-1/3 border-1" />

		<p class="text-pretty lg:text-lg">{lead}</p>

		<dl class="mt-6 space-y-4">
			{
				questions.map((item) => (
					<div>
						<dt class="text-primary-500 text-sm">{item.q}</dt>
						<dd class="mt-1 text-pretty">{item.a}</dd>
					</div>
				))
			}
		</dl>
	</div>
</article>
