---
/**
 * * Contact section for the website
 */

import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

interface Props {
	class?: string;
}

const { class: className } = Astro.props as Props;

import venueImage from "@assets/images/enlee-exterior-day.jpg";
---

<section
	id="contact"
	class="mx-auto max-w-md scroll-mt-10 px-4 py-20 md:max-w-6xl md:py-32"
	class:list={[className]}
>
	<h2 class="h2 md:px-12 lg:text-6xl">ご予約・お問い合わせ</h2>
	<div class="mt-4 grid gap-y-14 md:mt-0 md:grid-cols-2">
		<div class="border-primary-300 pt-10 md:border-r md:pr-20 md:pl-12">
			<p class="description text-lg">
				お席のご予約はネット予約から。貸切パーティーやお弁当のご相談は、お電話または公式LINEからお気軽にお問い合わせください。
			</p>
			<div class="mx-auto mt-10 aspect-square overflow-hidden">
				<Image
					src={venueImage}
					alt="Enlee 外観。中央公園の緑に面した入口"
					width={450}
					densities={[1.5, 2]}
					class="h-full w-full object-cover"
				/>
			</div>
		</div>
		<div class="md:pr-12 md:pl-20">
			{/* 席のご予約はネット予約が主。最も直接的な導線として先頭に置く */}
			<a
				href="https://booking.ebica.jp/webrsv/search/e014121101/29492"
				target="_blank"
				rel="noopener noreferrer"
				class="bg-primary-200 hover:bg-primary-300 mt-10 flex items-center justify-center gap-3 px-6 py-4 text-lg font-medium transition"
			>
				<Icon name="tabler:calendar" class="size-6 shrink-0" />
				<span class="underline underline-offset-4">ネットで席を予約する</span>
			</a>
			<div class="flex flex-col gap-4 pt-4 sm:flex-row">
				<a
					href="https://lin.ee/ngJUcCC"
					target="_blank"
					rel="noopener noreferrer"
					class="border-primary-300 hover:bg-primary-50 flex items-center justify-center gap-3 border px-6 py-4 text-lg font-medium transition"
				>
					<Icon name="socials/line" class="size-6 shrink-0" />
					<span class="underline underline-offset-4">LINEでお問い合わせ</span>
				</a>
				<a
					href="https://www.instagram.com/enlee_fukuyama/"
					target="_blank"
					rel="noopener noreferrer"
					class="border-primary-300 hover:bg-primary-50 flex items-center justify-center gap-3 border px-6 py-4 text-lg font-medium transition"
				>
					<Icon name="socials/basil-instagram-solid" class="size-6 shrink-0" />
					<span class="underline underline-offset-4">Instagramをフォロー</span>
				</a>
			</div>
			<dl class="flex flex-col gap-8 pt-10 text-lg lg:text-xl">
				<div>
					<dt class="font-heading-1 tracking-wide uppercase">TEL</dt>
					<dd class="mt-2">
						<a href="tel:0849997006" class="hover:text-primary-500 transition">084-999-7006</a>
					</dd>
				</div>
				<div>
					<dt class="font-heading-1 tracking-wide uppercase">住所</dt>
					<dd class="mt-2">
						<p>〒720-0812 広島県福山市霞町1-10-2（中央公園内）</p>
						{/* 埋め込みではなくリンク。外部Cookieを持ち込まず、スマホでは地図アプリが開く */}
						<a
							href="https://www.google.com/maps/search/?api=1&query=Enlee+%E7%A6%8F%E5%B1%B1%E5%B8%82%E9%9C%9E%E7%94%BA1-10-2"
							target="_blank"
							rel="noopener noreferrer"
							class="border-primary-300 hover:bg-primary-50 mt-3 inline-flex items-center gap-2 border px-4 py-2 text-base transition"
						>
							<Icon name="tabler:map-pin" class="size-5 shrink-0" />
							<span class="underline underline-offset-4">Googleマップで見る</span>
						</a>
					</dd>
				</div>
				<div>
					<dt class="font-heading-1 tracking-wide uppercase">営業時間</dt>
					<dd class="mt-2">11:00–21:00（L.O 20:00）／定休日：火曜日</dd>
				</div>
				<div>
					<dt class="font-heading-1 tracking-wide uppercase">ランチのご予約</dt>
					<dd class="mt-2">
						ネット予約でのランチタイムのご予約は、11:00〜12:00の間にご入店いただける方に限らせていただいております。
					</dd>
				</div>
				<div>
					<dt class="font-heading-1 tracking-wide uppercase">アクセス</dt>
					<dd class="mt-2">
						<p>中央図書館（ローズコム）のとなり、中央公園の中にあります。</p>
						<p class="mt-2">専用駐車場はございません。近隣のコインパーキングをご利用ください。</p>
					</dd>
				</div>
				<div>
					<dt class="font-heading-1 tracking-wide uppercase">お子様連れ</dt>
					<dd class="mt-2">
						<p>
							キッズメニュー（カレーライス・オムライスなど）をご用意しています。開放的な店内とテラス席があり、公園の中なので、お食事の前後に外で遊んでいただくこともできます。
						</p>
					</dd>
				</div>
				<div>
					<dt class="font-heading-1 tracking-wide uppercase">ペット同伴</dt>
					<dd class="mt-2">
						ペット同伴の場合、ネット予約はご利用いただけません。お手数ですが、お電話でお問い合わせください。
					</dd>
				</div>
			</dl>
		</div>
	</div>
</section>
