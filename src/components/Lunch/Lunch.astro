---
/**
 * * Lunch section — everyday appeal, not group bookings
 */

import Button from "@components/Button/Button.astro";
import obanzaiImage from "@assets/images/enlee-lunch-obanzai.jpg";
import lunchImage from "@assets/images/enlee-lunch-salad.jpg";
import pizzaImage from "@assets/images/enlee-pizza-margherita.jpg";
import { Image } from "astro:assets";

interface Props {
	compact?: boolean; // ホームではダイジェスト表示にし、詳細は /lunch へ誘導する
}

const { compact = false } = Astro.props as Props;

// 写真がどの料理かを明示し、価格との食い違いによる誤解を防ぐ
const lunchPhotos = [
	{ image: obanzaiImage, name: "Enlee食堂のおばんざい定食", price: "¥1,450" },
	{ image: pizzaImage, name: "ピザ・マルゲリータ", price: "¥1,500" },
];
---

<section id="lunch" class="site-container scroll-mt-10 py-20 md:py-32">
	<div class="flex flex-col md:flex-row-reverse">
		<div class="md:w-2/3 md:pl-16">
			<h2 class="h3 text-primary-500 text-pretty uppercase">Lunch</h2>
			<h3 class="h2 mt-4">庭を眺めながら、ゆっくりとしたお昼を。</h3>
			<div class="mt-8 lg:text-lg">
				<p>
					旬の野菜をたっぷり使ったプレートや、自家製デミグラスのオムライス、注文を受けてから焼き上げるピザ。忙しい日常の合間にも、緑を感じながら深呼吸できるような、そんなランチをご用意しています。
				</p>
				{
					!compact && (
						<p class="mt-4">
							お一人でのご来店も、お友達とのランチも。ふらりと立ち寄っていただけたら嬉しいです。
						</p>
					)
				}
			</div>
			<p class="description mt-6 text-sm">11:00–14:00（L.O）</p>
			{
				compact && (
					<div class="mt-10 flex">
						<Button href="/lunch" variant="outline" arrow="right" class="px-8">
							ランチについて詳しく見る
						</Button>
					</div>
				)
			}
		</div>
		<div class="mr-auto mt-8 max-w-md md:mt-0 md:w-1/3 md:max-w-none">
			<div class="my-auto aspect-[3/4] w-full overflow-hidden">
				<Image
					src={lunchImage}
					alt="Enleeの自家製鶏ハムとアボカドの農園サラダランチ"
					width={450}
					densities={[1.5, 2]}
					class="h-auto min-h-full w-full min-w-full object-cover"
				/>
			</div>
			<p class="text-base-900/60 mt-3 text-center text-xs leading-relaxed">
				写真は「自家製鶏ハムとアボカドの農園サラダランチ」（¥1,540）です。
			</p>
		</div>
	</div>

	{
		!compact && (
			<div class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-8 sm:grid-cols-2 md:mt-24">
				{lunchPhotos.map((photo) => (
					<div>
						<div class="aspect-[4/3] overflow-hidden">
							<Image
								src={photo.image}
								alt={`Enleeの${photo.name}`}
								width={450}
								densities={[1.5, 2]}
								class="h-full w-full object-cover"
							/>
						</div>
						<p class="text-base-900/60 mt-3 text-center text-xs leading-relaxed">
							写真は「{photo.name}」（{photo.price}）です。
						</p>
					</div>
				))}
			</div>
		)
	}
</section>
