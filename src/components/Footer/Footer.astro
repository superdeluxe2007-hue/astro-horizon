---
import SiteLogo from "@components/SiteLogo/SiteLogo.astro";
import siteData from "@config/siteData.json";
import { Icon } from "astro-icon/components";

import FooterLink from "./FooterLink.astro";

const today = new Date();
---

<footer class="bg-base-100/40 mt-12 flex flex-col items-center justify-center py-8">
	<div class="site-container">
		<!-- footer links -->
		<div
			class="flex w-full flex-col items-center justify-between gap-2 text-lg md:grid md:grid-cols-5"
		>
			<div class="flex justify-center py-2 text-center md:hidden">
				<SiteLogo />
			</div>
			<div class="col-span-2 flex justify-end gap-4">
				<FooterLink href="/">ホーム</FooterLink>
				<FooterLink href="/about">Enleeについて</FooterLink>
			</div>
			<div class="hidden justify-center text-center md:flex">
				<SiteLogo />
			</div>
			<div class="flex flex-wrap justify-center gap-x-4 gap-y-1 md:col-span-2 md:justify-start">
				<FooterLink href="/portfolio">パーティー・お弁当</FooterLink>
				<FooterLink href="/guide">ご利用ガイド</FooterLink>
				<FooterLink href="/calendar">営業カレンダー</FooterLink>
				<FooterLink href="#contact">お問い合わせ</FooterLink>
			</div>
		</div>

		<!-- lets connect -->
		<div class="description mx-auto mt-6 max-w-[21rem] px-4 text-center">
			<p>
				<span class="italic">Follow us!</span> Instagramで日々のEnleeの様子を発信しています。
			</p>
		</div>

		<!-- socials -->
		<div class="text-primary-500 mt-8 flex justify-center gap-6">
			<a
				href="https://www.instagram.com/enlee_fukuyama/"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Instagram"
			>
				<Icon name="socials/basil-instagram-solid" class="size-11 transition hover:opacity-80" />
				<span class="sr-only">Instagram</span>
			</a>
			<a href="https://lin.ee/ngJUcCC" target="_blank" rel="noopener noreferrer" aria-label="LINE">
				<Icon name="socials/line" class="size-11 transition hover:opacity-80" />
				<span class="sr-only">LINE</span>
			</a>
		</div>

		<!-- copyright -->
		<div class="mt-8 flex flex-col items-center gap-2 text-sm opacity-80">
			<div class="flex gap-4">
				<a href="/recruit" class="hover:text-primary-500 underline underline-offset-4 transition">
					採用情報
				</a>
				<a href="/faq" class="hover:text-primary-500 underline underline-offset-4 transition">
					よくあるご質問
				</a>
				<a
					href="/privacy-policy"
					class="hover:text-primary-500 underline underline-offset-4 transition"
				>
					プライバシーポリシー
				</a>
			</div>
			{/* 関連サイト・運営（小さく1行。メニューや予約の手前には置かない・2026-11-13） */}
			<p class="mt-2 text-center leading-relaxed">
				関連サイト：<a href="https://kokon-fukuyama.com/" target="_blank" rel="noopener" class="hover:text-primary-500 underline underline-offset-4 transition">レンタルスペース KOKON（福山市明治町）</a>
				<span class="mx-1">／</span>
				<a href="https://gdnfukuyama.com/" target="_blank" rel="noopener" class="hover:text-primary-500 underline underline-offset-4 transition">中央公園のイベント Good Day Neighbors</a>
			</p>
			<p>運営：株式会社SPDX</p>
			<p class="mb-2">&copy; {today.getFullYear()} {siteData.name}. All rights reserved.</p>
		</div>
	</div>
</footer>
