---
/**
 * クリスマスのご予約の案内（トップ・お弁当ページに置く小さな枠）。
 * 受付の期限を過ぎると自動で消える（data-xmas-hide-after）。
 * 値は src/data/christmas.ts から読む。
 */
import XmasExpiry from "@components/Christmas/XmasExpiry.astro";
import { XMAS } from "@/data/christmas";
import { Image } from "astro:assets";

interface Props {
	class?: string;
}
const { class: className } = Astro.props as Props;
---

<XmasExpiry until={XMAS.until} />
<aside data-xmas-hide-after class:list={["site-container", className]}>
	<a
		href="/christmas/"
		class="border-primary-200 hover:bg-primary-50 mx-auto flex max-w-3xl items-center gap-5 border-2 p-4 transition md:gap-8 md:p-6"
	>
		<div class="aspect-square w-24 shrink-0 overflow-hidden md:w-32">
			<Image src={XMAS.heroImage} alt="クリスマスのパリブレスト" width={160} densities={[1.5, 2]} class="h-full w-full object-cover" />
		</div>
		<div>
			<p class="text-primary-500 text-sm tracking-widest uppercase">Christmas {XMAS.year}</p>
			<p class="font-heading-1 mt-1 text-lg md:text-xl">クリスマスのケーキ・オードブル ご予約受付中</p>
			<p class="text-base-900/70 mt-1 text-sm">
				ご予約は{XMAS.deadlineLabel}まで／お受け取りは{XMAS.pickupDays.join("・")}
			</p>
			<span class="text-primary-500 mt-2 inline-block text-sm underline">くわしく見る →</span>
		</div>
	</a>
</aside>
