---
/**
 * * Evening cafe / dessert & wine section
 */

import Button from "@components/Button/Button.astro";
import fontainebleauImage from "@assets/images/enlee-dessert-fontainebleau.jpg";
import frenchToastImage from "@assets/images/enlee-french-toast-classic.jpg";
import gateauChocolatImage from "@assets/images/enlee-gateau-chocolat.jpg";
import { Image } from "astro:assets";

interface Props {
	compact?: boolean; // ホームではダイジェスト表示にし、詳細は /evening-cafe へ誘導する
}

const { compact = false } = Astro.props as Props;

// 見出しの階層: ホーム（compact）はページの h1 が Hero にあるので h2／h3。
// 専用ページではこのセクションがページ本体なので h1／h2 に繰り上げる。見た目は class で固定。
const Eyebrow = compact ? "h2" : "h1";
const Heading = compact ? "h3" : "h2";

// 写真がどの商品かを明示し、価格との食い違いによる誤解を防ぐ
const images = [
	{ src: frenchToastImage, name: "クラシックフレンチトースト", price: "¥780" },
	{ src: fontainebleauImage, name: "フォンティーヌブロー（フロマージュブラン）", price: "¥1,680" },
	{ src: gateauChocolatImage, name: "ガトーショコラ", price: "¥600" },
];

---

<section id="evening-cafe" class="bg-base-100 scroll-mt-10 py-20 md:py-32">
	<div class="site-container">
		<div class="mx-auto max-w-2xl text-center">
			<Eyebrow class="h3 text-primary-500 text-pretty uppercase">Evening Cafe</Eyebrow>
			<Heading class="h2 mt-4">灯りがともる頃、少し特別なデザートタイム。</Heading>
			<p class="description mt-6 lg:text-lg">
				フレンチトースト、フロマージュブラン、季節のフルーツを使ったデザート。日が暮れて庭に灯りがともる時間は、ワインやシードルを片手にゆっくりとデザートを楽しむひとときに変わります。
			</p>
		</div>
		<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-3 md:mt-16">
			{
				images.map((img) => (
					<div>
						<div class="aspect-[3/4] overflow-hidden">
							<Image
								src={img.src}
								alt={`Enleeの${img.name}`}
								width={450}
								densities={[1.5, 2]}
								class="h-full w-full object-cover"
							/>
						</div>
						<p class="text-base-900/60 mt-3 text-center text-xs leading-relaxed">
							写真は「{img.name}」（{img.price}）です。
						</p>
					</div>
				))
			}
		</div>
		<p class="description mt-8 text-center text-sm">フード 14:00〜21:00（L.O.20:00）</p>
		{
			compact && (
				<div class="mt-10 flex justify-center">
					<Button href="/evening-cafe" variant="outline" arrow="right">
						夜カフェについて詳しく見る
					</Button>
				</div>
			)
		}
	</div>
</section>
