---
import siteData from "@config/siteData.json";
import { getImage } from "astro:assets";
import { SEO } from "astro-seo";

interface BaseProps {
	title: string;
	description: string;
	noindex?: boolean;
}

interface GenProps extends BaseProps {
	type: "general" | undefined;
	image?: ImageMetadata;
}

const { title = "general", description, image, noindex = false } = Astro.props as GenProps;

// 下層ページの title は「ランチ」のように短く渡されるため、検索結果でどこの店か分かるよう
// 屋号と場所を添える。トップ（title がサイト名そのもの）は二重にしない。
const pageTitle = title === siteData.title ? title : `${title}｜${siteData.titleSuffix}`;

let optimizedImage;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

// if this is a blog page we do things differently
if (image) {
	optimizedImage = await getImage({
		src: image,
		format: "webp",
		quality: "high",
		width: 1200,
	});
}

function trimEndSlash(str: string) {
	if (str[str.length - 1] === "/") {
		return str.slice(0, -1);
	} else {
		return str;
	}
}

// put together the image URL
const imageUrl =
	trimEndSlash(Astro.site?.toString() || "") + (optimizedImage?.src || siteData.defaultImage.src);
---

<SEO
	title={pageTitle}
	description={description}
	canonical={canonicalUrl.toString()}
	openGraph={{
		basic: {
			title: pageTitle,
			type: "website",
			image: imageUrl,
			url: canonicalUrl.toString(),
		},
		optional: {
			description: description,
			siteName: siteData.title,
		},
		image: {
			// ページ個別の画像はwebpに最適化されるが、フォールバックは実体がjpgなので分ける
			type: optimizedImage ? "image/webp" : "image/jpeg",
			width: optimizedImage?.attributes.width || "1200",
			height: optimizedImage?.attributes.height || "630",
			alt: optimizedImage ? title : siteData.defaultImage.alt,
		},
	}}
	twitter={{
		// アカウント未設定のときに "@" だけのタグを出さない
		...(siteData.author.twitter
			? { site: "@" + siteData.author.twitter, creator: "@" + siteData.author.twitter }
			: {}),
		card: "summary_large_image",
		title: pageTitle,
		description: description,
		image: imageUrl,
	}}
	noindex={noindex}
	nofollow={noindex}
/>
